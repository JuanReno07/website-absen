# Database Configuration (Local SQLite or Turso LibSQL)
DATABASE_URL="file:./dev.db"
TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Authentication (Minimum 32 characters random secret)
JWT_SECRET="replace-with-at-least-32-char-cryptographic-random-secret"

# Application Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Trusted Reverse Proxy (set to "true" only behind trusted Nginx/Cloudflare/load balancer)
TRUST_PROXY="false"
